# Deny by default: only what is explicitly allowed below can be added to git.
# Local test artifacts, secrets (.env), and tooling stay out without a rule
# for each one. Tracked files are unaffected.
/*
!/.claude-plugin/
!/.claude-plugin/**
!/hooks/
!/hooks/**
!/.github/
!/.github/**
!/benchmarks/
!/benchmarks/**
!/docs/
!/docs/**
!/service/
!/service/**
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/tests/
!/tests/**
!/.coderabbit.yaml
!/.dockerignore
!/.env.example
!/.gitignore
!/.pre-commit-hooks.yaml
!/CODE_OF_CONDUCT.md
!/compose-check.sh
!/compose.yaml
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/pytest.ini
!/README.md
!/Dockerfile
!/requirements.txt
!/requirements-dev.txt
!/DEPLOYMENT.md
!/start-server.bat
!/ruff.toml
!/SECURITY.md

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak

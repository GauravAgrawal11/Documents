# ==============================================================================
# Watermarks Remover & Document Studio — Environment Configuration
# ==============================================================================
# Copy this file to `.env` to configure the application.

# ------------------------------------------------------------------------------
# 1. Core Server Configuration
# ------------------------------------------------------------------------------
WATERMARKS_SERVER_HOST=127.0.0.1
WATERMARKS_SERVER_PORT=8765
# Optional Bearer Token for API Authentication
# When set, every HTTP request must send `Authorization: Bearer <key>`
WATERMARKS_SERVER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Client & Web Application URL
# ------------------------------------------------------------------------------
WATERMARKS_SERVICE_URL=http://127.0.0.1:8765

# ------------------------------------------------------------------------------
# 3. AI Providers & Grammar Engine Configuration (Optional)
# ------------------------------------------------------------------------------
# Groq Cloud API Key (for high-speed Layer B rewriting & grammatical fixes)
GROQ_API_KEY=

# OpenAI API Key (Alternative Layer B provider)
OPENAI_API_KEY=

# Anthropic Claude API Key (Alternative Layer B provider)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 4. Layer B Statistical Watermark Rewrite Backend
# ------------------------------------------------------------------------------
# Options: ollama | groq | openai-compatible | anthropic
WATERMARKS_REWRITE_BACKEND=groq
WATERMARKS_REWRITE_MODEL=llama-3.3-70b-versatile
# Ollama local endpoint (if using ollama backend)
# OLLAMA_HOST=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# 5. Production & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=False
